node_modules/
out/
.remotion/

# Secrets: never commit API keys. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Source documents are private: never commit lecture PDFs.
# A synthetic demo document is generated on demand by server/sample.js.
/Documentry-ai-genrator/server/*.pdf

# Ignore generated audio runtime assets
public/audio/*.mp3
public/audio/*.wav
/Documentry-ai-genrator/public/audio/*.mp3
/Documentry-ai-genrator/public/audio/*.wav
# Per-session audio written by the website (public/audio/<sessionId>/...)
/Documentry-ai-genrator/public/audio/*/
# Uploads + per-session datasets written by the website server
/Documentry-ai-genrator/.data/
# Session history database (runtime data, rebuilt by generating videos)
/Documentry-ai-genrator/server/sessions.json

# Ignore rendered output videos
out/                             

# Generated website bundle (rebuild with: npm run web:build)
/Documentry-ai-genrator/web/dist/

# Local voice-cloning stack (large binaries, never commit)
#   .venv/                 ~1 GB of Python packages
#   OpenVoice/             upstream git clone
#   MeloTTS/              upstream git clone
#   checkpoints_v2/        ~125 MB model weights
#   nltk_data/             downloaded corpora
#   .cache/                extracted tone colours and temp audio
/Documentry-ai-genrator/server/voice/.venv/
/Documentry-ai-genrator/server/voice/OpenVoice/
/Documentry-ai-genrator/server/voice/MeloTTS/
/Documentry-ai-genrator/server/voice/checkpoints_v2/
/Documentry-ai-genrator/server/voice/nltk_data/
/Documentry-ai-genrator/server/voice/.cache/
#   __pycache__/           compiled Python
/Documentry-ai-genrator/server/voice/__pycache__/ 