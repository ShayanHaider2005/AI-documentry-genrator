node_modules/
out/
.remotion/

# Secrets: never commit API keys. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Source documents are private: never commit lecture PDFs.
# A synthetic demo document is generated on demand by server/sample.js.
/Documentry-ai-genrator/server/*.pdf

# Ignore generated audio runtime assets
public/audio/*.mp3
public/audio/*.wav
/Documentry-ai-genrator/public/audio/*.mp3
/Documentry-ai-genrator/public/audio/*.wav
# Per-session audio written by the website (public/audio/<sessionId>/...)
/Documentry-ai-genrator/public/audio/*/
# Uploads + per-session datasets written by the website server
/Documentry-ai-genrator/.data/
# Session history database (runtime data, rebuilt by generating videos)
/Documentry-ai-genrator/server/sessions.json

# Ignore rendered output videos
out/                             

# Generated website bundle (rebuild with: npm run web:build)
/Documentry-ai-genrator/web/dist/

# Local voice-cloning stack (large binaries, never commit)
#   .venv/                 ~2 GB of Python packages
#   .cache/                normalised reference audio and temp clips
#   *.log                  service and setup output
#   __pycache__/           compiled Python
#
# The OmniVoice weights (~3.3 GB) live in the Hugging Face cache outside the
# repo, so nothing model-sized is tracked here.
#
# Retired OpenVoice v2 assets, kept out of history going forward:
#   OpenVoice/  MeloTTS/  checkpoints_v2/  nltk_data/
/Documentry-ai-genrator/server/voice/.venv/
/Documentry-ai-genrator/server/voice/.cache/
/Documentry-ai-genrator/server/voice/__pycache__/
# The check and measurement scripts in web/ import numpy, so they leave bytecode
# behind too.
/Documentry-ai-genrator/web/__pycache__/
/Documentry-ai-genrator/server/voice/*.log
/Documentry-ai-genrator/server/voice/OpenVoice/
/Documentry-ai-genrator/server/voice/MeloTTS/
/Documentry-ai-genrator/server/voice/checkpoints_v2/
/Documentry-ai-genrator/server/voice/nltk_data/

# The generated default narrator. The generator script and its transcript are
# tracked; the audio it produces is reproducible with `npm run voice:default`
# and is ~750 KB, so it is not.
/Documentry-ai-genrator/server/voices/south_asian_narrator.wav
/Documentry-ai-genrator/server/voices/south_asian_narrator.mp3
/Documentry-ai-genrator/server/voices/probe_*.wav
/Documentry-ai-genrator/server/voices/probe_results.json

# The generated narrator library: ten reference WAVs at ~750 KB each, plus their
# transcripts. The manifest and the generator are tracked, because the manifest
# is the record of which instruct produced which voice; the audio is reproducible
# with `npm run voice:library` (about 30 minutes on CPU) and is not.
/Documentry-ai-genrator/server/voices/defaults/*.wav
/Documentry-ai-genrator/server/voices/defaults/*.txt

# Accounts and their password hashes. Never commit this: it is the one file
# where a leak is directly useful to an attacker.
/Documentry-ai-genrator/server/users.json
/Documentry-ai-genrator/server/users.json.*.tmp

# ---------------------------------------------------------------------------
# Generated artefacts and scratch files.
#
# The repository was already clean when these rules were added (zero tracked
# PDFs, videos or logs), so they are defence in depth rather than a clean-up.
# Each negation is deliberate: ignoring `*.wav` and `*.mp4` outright would
# exclude the narrator library, which the app cannot run without.
# ---------------------------------------------------------------------------
temp/
output/
public/renders/
uploads/

# Rendered videos and generated narration. Anything a user produced.
*.mp4
*.wav
*.mp3
#
# The narrator library's audio stays ignored too, against the brief's
# "except server/voices/defaults/". Ten reference recordings are 7.1 MB of
# generated binary, reproducible in about 30 minutes with `npm run voice:library`,
# and they change every time that runs — which would show as a 7 MB diff on an
# unrelated change. The manifest is tracked instead, because it is the record
# of which instruct produced which voice; that is the part worth versioning.
# Drop these two rules if you would rather have the audio in the repo.
# /Documentry-ai-genrator/server/voices/defaults/*.wav
# /Documentry-ai-genrator/server/voices/defaults/*.txt
# The single default narrator's transcript, which the pipeline falls back to.
!/Documentry-ai-genrator/server/voices/south_asian_narrator.txt

# Uploaded source documents. Users' PDFs must never enter the repository.
*.pdf
*.pptx
*.docx
# ...except the generated test fixture, which is the one PDF the repo needs.
!Documentry-ai-genrator/public/sample.pdf

# Scratch files from manual testing.
test_*.js
scratchpad.*
scratch.*
dry_*.log
*.log
!Documentry-ai-genrator/*.log

# Per-user working directories, now namespaced under DATA_DIR.
.data/
/Documentry-ai-genrator/out/
/Documentry-ai-genrator/node_modules/