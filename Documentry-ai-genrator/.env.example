# ==============================================================================
# AI DOCUMENTARY & ONLINE TEACHER LECTURE GENERATOR — CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT VOICE CLONING (Instant Voice Cloning from MP3)
# ------------------------------------------------------------------------------
# To clone the client's voice from an MP3 sample at runtime, provide your ElevenLabs API key.
# When provided, the pipeline uploads the client MP3 voice sample to ElevenLabs,
# clones the voice instantly, and synthesizes the documentary in the client's voice!
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional pre-configured voice ID (if not cloning from MP3 sample at runtime):
# ELEVENLABS_VOICE_ID=your_voice_id_here

# ------------------------------------------------------------------------------
# 2. AI SCRIPT GENERATOR (Summarizes PDF into Educational Chapters)
# ------------------------------------------------------------------------------
# Choose any of the following providers for AI educational summarization:

# Option A: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Option B: Groq (Ultra-fast Llama 3)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option C: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option D: xAI Grok
# GROK_API_KEY=your_xai_api_key_here
# GROK_MODEL=grok-3-mini
