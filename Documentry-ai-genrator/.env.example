# ==============================================================================
# AI DOCUMENTARY & ONLINE TEACHER LECTURE GENERATOR - CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in the keys you need.
# `.env` is gitignored - never commit real keys.
# Every key is optional: without them the engine falls back to document
# diagrams, a neural teacher voice, and the built-in script synthesizer.

# ------------------------------------------------------------------------------
# 1. CONTEXTUAL VISUALS (Pexels stock photos)
# ------------------------------------------------------------------------------
# With a key, each part of each scene gets a contextual stock photo.
# Without it, the engine synthesises document-structure diagrams from the
# uploaded PDF instead - so a visual is never a generic, unrelated image.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 2. CLIENT VOICE CLONING (Instant Voice Cloning from an audio sample)
# ------------------------------------------------------------------------------
# To clone the client's voice from their sample at runtime, provide your
# ElevenLabs API key. The pipeline uploads the sample, clones the voice
# instantly, and narrates the whole documentary in the client's voice.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional pre-configured voice ID (if not cloning from a sample at runtime):
# ELEVENLABS_VOICE_ID=your_voice_id_here

# ------------------------------------------------------------------------------
# 3. AI SCRIPT GENERATOR + CHATBOT
# ------------------------------------------------------------------------------
# Enables LLM scene writing and the "Ask DocuBot" chat panel.
# Choose any one of the following providers:

# Option A: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Option B: Groq (Ultra-fast Llama 3)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option C: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option D: xAI Grok
# GROK_API_KEY=your_xai_api_key_here
# GROK_MODEL=grok-3-mini

# ------------------------------------------------------------------------------
# 4. WEB SERVER LIMITS (optional)
# ------------------------------------------------------------------------------
# PORT=3100
# RATE_LIMIT_PER_MINUTE=20
# MAX_CONCURRENT_RENDERS=1
# SESSION_TTL_MINUTES=120
