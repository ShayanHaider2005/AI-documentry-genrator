# ==============================================================================
# AI DOCUMENTARY & ONLINE TEACHER LECTURE GENERATOR - CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in the keys you need.
# `.env` is gitignored - never commit real keys.
# Every key is optional: without them the engine falls back to document
# diagrams, a neural teacher voice, and the built-in script synthesizer.

# ------------------------------------------------------------------------------
# 1. CONTEXTUAL VISUALS (Pexels stock photos)
# ------------------------------------------------------------------------------
# With a key, each part of each scene gets a contextual stock photo.
# Without it, the engine synthesises document-structure diagrams from the
# uploaded PDF instead - so a visual is never a generic, unrelated image.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 2. VOICE CLONING (OmniVoice - local, no API key needed)
# ------------------------------------------------------------------------------
# Voice cloning runs entirely on this machine, so there is nothing to configure
# here. One-time setup, then start the service:
#
#   npm run voice:setup     # installs the venv and downloads ~3.3 GB of weights
#   npm run voice:start     # or just "npm run web", which starts both
#
# The website reports the service as available or not; narration falls back to a
# built-in neural voice when it is not running.
#
# OMNIVOICE_URL=http://127.0.0.1:8000
# OMNIVOICE_PORT=8000
# OMNIVOICE_MODEL=k2-fsa/OmniVoice
# # Reference used when the client uploads no sample of their own.
# # OMNIVOICE_DEFAULT_REF=server/voices/south_asian_narrator.wav
# OMNIVOICE_DEFAULT_INSTRUCT=male, indian accent, moderate pitch
#
# `instruct` is a CLOSED vocabulary. Anything outside it is a hard error, not a
# hint, and the model replies with the list of what it accepts. Valid English
# items, comma + space separated:
#
#   gender   male, female
#   age      child, teenager, young adult, middle-aged, elderly
#   pitch    very low pitch, low pitch, moderate pitch, high pitch, very high pitch
#   style    whisper
#   accent   american accent, australian accent, british accent, canadian accent,
#            indian accent, chinese accent, japanese accent, korean accent,
#            portuguese accent, russian accent
#
# Note: there is no "pakistani accent" in that list, and no free-form style
# words such as "documentary narrator" or "warm". For a genuine Pakistani voice,
# upload a real recording instead — cloning reproduces the speaker's accent
# exactly, whereas voice design can only approximate one from this list.
#
# Free VRAM needed before the GPU is used at all; below this, CPU.
# OMNIVOICE_GPU_MIN_FREE_GB=6
# # Diffusion decoding steps. Cost is near-linear in this, so 32 -> 16 roughly
# # halves generation time. 32 is full quality; lower it only when the CPU wait
# # is the bottleneck. Measured on CPU: ~240s for a 5s clip at 32 steps.
# OMNIVOICE_NUM_STEP=32
# # A cold model load can take minutes on CPU.
# OMNIVOICE_BOOT_TIMEOUT_MS=1800000
# OMNIVOICE_SYNTH_TIMEOUT_MS=900000

# ------------------------------------------------------------------------------
# 3. AI SCRIPT GENERATOR (optional)
# ------------------------------------------------------------------------------
# Enables LLM scene writing. Providers are tried in order with automatic
# failover, so configuring two makes the pipeline far more reliable.
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GROK_API_KEY=your_xai_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. WEB SERVER LIMITS (optional)
# ------------------------------------------------------------------------------
# PORT=3100
# RATE_LIMIT_PER_MINUTE=20
# MAX_CONCURRENT_RENDERS=1
# SESSION_TTL_MINUTES=120
