# ==============================================================================
# AI DOCUMENTARY & ONLINE TEACHER LECTURE GENERATOR - CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in the keys you need.
# `.env` is gitignored - never commit real keys.
# Every key is optional: without them the engine falls back to document
# diagrams, a neural teacher voice, and the built-in script synthesizer.

# ------------------------------------------------------------------------------
# 1. CONTEXTUAL VISUALS (Pexels stock photos)
# ------------------------------------------------------------------------------
# With a key, each part of each scene gets a contextual stock photo.
# Without it, the engine synthesises document-structure diagrams from the
# uploaded PDF instead - so a visual is never a generic, unrelated image.
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ------------------------------------------------------------------------------
# 2. VOICE CLONING (OpenVoice v2 - local, no API key needed)
# ------------------------------------------------------------------------------
# Voice cloning runs entirely on this machine, so there is nothing to configure
# here. One-time setup, then start the service:
#
#   py -3 server/voice/setup.py                          (installs + downloads models)
#   server/voice/.venv\Scripts\python.exe server/voice/service.py
#
# The website reports the service as available or not; narration falls back to a
# built-in neural voice when it is not running.
# OPENVOICE_URL=http://127.0.0.1:5055
# OPENVOICE_DEVICE=cpu
# OPENVOICE_PORT=5055
# OPENVOICE_TAU=0.3

# ------------------------------------------------------------------------------
# 3. AI SCRIPT GENERATOR (optional)
# ------------------------------------------------------------------------------
# Enables LLM scene writing. Providers are tried in order with automatic
# failover, so configuring two makes the pipeline far more reliable.
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GROK_API_KEY=your_xai_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. WEB SERVER LIMITS (optional)
# ------------------------------------------------------------------------------
# PORT=3100
# RATE_LIMIT_PER_MINUTE=20
# MAX_CONCURRENT_RENDERS=1
# SESSION_TTL_MINUTES=120
