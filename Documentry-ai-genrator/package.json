{
  "name": "documentary-ai-generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "pipeline": "node server/pipeline.js",
    "studio": "npm run studio:props && remotion studio --props=public/input-props.json",
    "preview": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts Documentary out/video.mp4",
    "web:build": "node web/build.js",
    "web": "npm run web:build && node server/serve.js",
    "web:serve": "node server/serve.js",
    "web:only": "node server/web.js",
    "web:smoke": "node web/smoke.js",
    "check:unique": "node web/check-unique.js",
    "check:conclusion": "node web/check-conclusion.js",
    "voice:setup": "py -3 server/voice/setup.py",
    "voice:start": "server\\voice\\.venv\\Scripts\\python.exe server/voice/server.py",
    "voice:check": "node web/check-voice.js",
    "voice:check:client": "node web/check-voice-client.js",
    "voice:library": "server\\voice\\.venv\\Scripts\\python.exe server/voices/make_voice_library.py",
    "check:library": "node web/check-library-auth.js",
    "check:auth": "node web/check-server-auth.js",
    "check:render-props": "node web/check-render-props.js",
    "check:render-audio": "node web/check-render-audio.js",
    "check:produced-audio": "node web/check-produced-audio.js",
    "check:ui": "node web/check-ui-contract.js",
    "check:voices": "server\\voice\\.venv\\Scripts\\python.exe web/check-voice-library-distinct.py",
    "check:produce": "node web/check-produce-route.js",
    "check:motion": "node web/check-motion.js",
    "check:bot": "node web/check-bot.js",
    "check:ambient": "node web/check-ambient.js",
    "check:security": "node web/check-security-routing.js",
    "check:isolation": "node web/check-isolation.js",
    "check:all": "npm run build && npm run check:budget && npm run check:render-props && npm run check:library && npm run check:auth && npm run check:ui && npm run check:produce && npm run check:motion && npm run check:bot && npm run check:ambient && npm run check:security && npm run check:isolation && npm run check:okf && npm run check:chat && npm run check:script-gen",
    "check:budget": "node web/check-word-budget.js",
    "dry:reftext": "node web/dry-ref-text.js",
    "check:audio": "server\\voice\\.venv\\Scripts\\python.exe web/check-audio-quality.py",
    "voice:probe": "server\\voice\\.venv\\Scripts\\python.exe server/voices/probe_omnivoice.py",
    "voice:default": "server\\voice\\.venv\\Scripts\\python.exe server/voices/make_default_voice.py",
    "check:okf": "node web/check-okf.js",
    "check:chat": "node web/check-chat.js",
    "check:models": "node web/check-model-candidates.js",
    "check:script-gen": "node web/check-script-gen.js",
    "studio:props": "node web/sync-studio-props.js",
    "render:fast": "remotion render src/index.ts Documentary out/fast.mp4 --timeout=120000 --gl=angle --props=public/input-props.json"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.529",
    "@remotion/player": "^4.0.529",
    "@remotion/renderer": "^4.0.529",
    "framer-motion": "^13.4.5",
    "msedge-tts": "^2.0.8",
    "music-metadata": "^11.16.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
